# ASI QB Middleware -- environment config template
# Copy this to .env and fill in real values.
# For workstation installs, use the Inno Setup installer -- it handles .env automatically.

# Shared API key -- must match QB_APIKey in FileMaker's Reference table.
API_KEY=change-me-to-something-secret

# Flask port (default 5100)
PORT=5100

# QuickBooks company file paths on the Q: drive.
# Use the full path including drive letter and .QBW extension.
QB_FILE_ACOUSTICAL=Q:\Path\To\Acoustical Surfaces.QBW
QB_FILE_ARCHITECTURAL=Q:\Path\To\Architectural Surfaces.QBW
