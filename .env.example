# Copy this to .env and fill in real values

# Shared secret — FileMaker sends this in X-API-Key header on every request
API_KEY=change-me-to-something-secret

# Web Connector credentials — must match what's set in each .qwc config file
WC_USER_ACOUSTICAL=asi_acoustical
WC_PASS_ACOUSTICAL=change-me
WC_USER_ARCHITECTURAL=asi_architectural
WC_PASS_ARCHITECTURAL=change-me

# Flask
FLASK_ENV=development
PORT=5100
