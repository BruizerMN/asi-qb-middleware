# ASI QB Middleware -- bundled configuration template
#
# INSTRUCTIONS:
#   1. Copy this file to bundled.env (same folder)
#   2. Fill in all values below
#   3. Run scripts\build-installer.ps1 to compile the installer
#
# bundled.env is gitignored -- it contains secrets. Never commit it.
# This example file is safe to commit.

# Build environment -- controls the installer filename.
#   DEV  = targeting test company files  → ASI_FMQBsupport_DEV_XXXX.exe
#   PROD = targeting production files    → ASI_FMQBsupport_PROD_XXXX.exe
ENVIRONMENT=DEV

# Shared API key -- must match QB_APIKey in FileMaker's Reference table.
API_KEY=

# Flask port (default 5100 -- only change if there is a conflict on workstations)
PORT=5100

# QuickBooks company file paths on the Q: drive.
# Use the FULL path including drive letter and .QBW extension.
# Example: Q:\Company Files\Acoustical Surfaces.QBW
QB_FILE_ACOUSTICAL=
QB_FILE_ARCHITECTURAL=
